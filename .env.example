# Copy to .env.local. These values are public (they end up in the browser bundle): no keys here.
# 1337 = local Ganache (npm run chain in landchain-contracts). 11155111 = Sepolia.
VITE_CHAIN_ID=1337
VITE_RPC_URL=http://127.0.0.1:7545

# Backend mode (task J4): set VITE_API_URL and the app reads and writes through landchain-backend
# instead of talking to the contracts directly. Leave it empty for chain-only mode.
VITE_API_URL=
# Supabase Auth for backend mode. The publishable key is safe in the browser; never put the secret key here.
# Leave both empty to use the backend's local dev login (DEV_AUTH=true, any demo email, no password).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Password the seeded demo users share (seed_demo_users)
VITE_DEMO_PASSWORD=landchain-demo
