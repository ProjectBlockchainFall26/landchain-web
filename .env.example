# Copy to .env.local. These values are public (they end up in the browser bundle): no keys here.
# chain (default): the deployed LandChain contracts.  demo: the in-browser demo engine, no chain needed.
VITE_LANDCHAIN_MODE=chain
# 1337 = local Ganache (npm run chain in landchain-contracts). 11155111 = Sepolia.
VITE_CHAIN_ID=1337
VITE_RPC_URL=http://127.0.0.1:7545
